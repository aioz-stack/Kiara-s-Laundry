# Copy to .env and replace every placeholder. Never commit .env.

# Used by docker-compose.yml to create the local database.
POSTGRES_USER="kiara"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="kiara_laundry"

# Must match the values above when using the Docker database.
DATABASE_URL="postgresql://kiara:change-me@localhost:5433/kiara_laundry"

# Public URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Outgoing email, used for "Forgot password?" links. Leave SMTP_PASSWORD empty to
# turn password reset by email off. For Gmail: turn on 2-Step Verification, then
# create an app password at https://myaccount.google.com/apppasswords and paste it
# here. Never use the account's normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-shop@gmail.com"
SMTP_PASSWORD=""
# Optional. Defaults to the shop name and SMTP_USER.
MAIL_FROM=""

# Password given to the demo accounts created by `npm run db:seed`.
# The seed refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="replace-with-a-demo-password"
