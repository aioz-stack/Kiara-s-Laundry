# Copy to .env and replace every placeholder. Never commit .env.

# Used by docker-compose.yml to create the local database.
POSTGRES_USER="kiara"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="kiara_laundry"

# Must match the values above when using the Docker database.
DATABASE_URL="postgresql://kiara:change-me@localhost:5433/kiara_laundry"

# Public URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Password given to the demo accounts created by `npm run db:seed`.
# The seed refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="replace-with-a-demo-password"
